---
// The full journal: every entry in full, newest first. Like the reflections ledger, the title,
// date and link sit on the left and the entry reads on the right; one column on phones.
// Long journals show a batch at a time behind a "show more" link.
import Arrow from './Arrow.astro';
import { fmtDate, craftsOf, type Post } from '../lib/posts';
import { render } from 'astro:content';

interface Props { posts: Post[]; batch?: number; }
const { posts, batch = 10 } = Astro.props;
const entries = await Promise.all(posts.map(async (p) => ({ post: p, Content: (await render(p)).Content })));
---
<div class="journal">
  <ol data-batch={batch}>
    {entries.map(({ post, Content }) => (
      <li>
        <article>
          <header>
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            <p class="meta">{[fmtDate(post.data.date), ...craftsOf(post).map((c) => c.label)].join(' · ')}</p>
            {post.data.link && (
              <a class="action out" href={post.data.link} rel="noopener">{post.data.linkLabel ?? 'Visit the site'} <Arrow /></a>
            )}
          </header>
          <div class="body"><Content /></div>
        </article>
      </li>
    ))}
  </ol>
  {posts.length > batch && (
    <button class="more action" type="button" hidden>Show more of the journal <Arrow /></button>
  )}
</div>

<script>
  import '../scripts/batch';
</script>

<style>
  ol { list-style: none; padding: 0; border-top: var(--rule); }
  li { padding: clamp(28px, 4vw, 44px) 0; border-bottom: 1px solid color-mix(in srgb, var(--ink) 30%, transparent); }
  /* The same split as the reflections ledger, so the two archives line up. */
  article {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 16px clamp(32px, 6vw, 96px);
    align-items: start;
  }
  /* On long entries the title and link stay in view beside the text. */
  header { display: grid; gap: 12px; justify-items: start; position: sticky; top: 24px; }
  .body { font-size: 1.0625rem; max-width: var(--measure); }
  h2 { font-size: clamp(2rem, 3.4vw, 2.75rem); }
  h2 a { text-decoration: none; }
  h2 a:hover { color: var(--rust); }
  .meta { font: 700 1rem/1.3 var(--display); letter-spacing: 0.06em; text-transform: uppercase; color: var(--rust); }
  .body { display: grid; gap: 1em; }
  .body :global(p) { line-height: 1.6; }
  .body :global(a) { color: var(--rust); }
  .out { display: inline-block; justify-self: start; color: var(--rust); padding-block: 6px; line-height: 1.2; }
  .out :global(svg) { display: inline-block; vertical-align: -0.2em; margin-left: 0.35em; }

  @media (max-width: 760px) {
    article { grid-template-columns: 1fr; }
    header { position: static; }
  }

  .more {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    display: inline-flex; align-items: center; gap: 0.5em;
    font: 700 1.125rem/1 var(--display); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--rust);
    padding: 14px 0; margin-top: 12px;
  }
  .more[hidden] { display: none; }
  .more :global(svg) { width: 1.1em; height: 1.1em; transform: rotate(90deg); transition: transform 0.4s var(--ease); }
  .more:hover :global(svg) { transform: rotate(90deg) translateX(4px); }
  .more:focus-visible { outline: 3px solid var(--rust); outline-offset: 2px; }
</style>

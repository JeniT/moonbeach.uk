---
// The poster: a full-bleed plate over a caption bar holding a headline and two doors.
import Plate from './Plate.astro';
import Arrow from './Arrow.astro';
interface Door { href: string; title: string; text: string; action: string; }
interface Props {
  art?: 'drawbridge' | 'wheel';
  imprint: string;
  lineOne: string;
  lineTwo: string;
  doors: [Door, Door];
}
const { art = 'drawbridge', imprint, lineOne, lineTwo, doors } = Astro.props;
---
<section class="poster" aria-labelledby="tagline">
  <div class="sheet">
    <Plate variant="hero" art={art} />
    <p class="imprint" set:html={imprint} />
  </div>
  <div class="bar">
    <h1 id="tagline">{lineOne}<br /><span>{lineTwo}</span></h1>
    {doors.map((d) => (
      <a class="door" href={d.href}>
        <h2>{d.title}</h2>
        <p>{d.text}</p>
        <span class="action">{d.action} <Arrow /></span>
      </a>
    ))}
  </div>
</section>

<style>
  /* First viewport: the plate over a caption bar, like a travel poster. */
  .poster {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    height: calc(100svh - 2 * var(--border) - 62px);
    min-height: 600px;
    max-height: 1000px;
  }
  .sheet { position: relative; min-height: 0; }
  .imprint {
    position: absolute; right: 0; bottom: 0;
    background: var(--ink); color: var(--stock);
    font-size: 0.8125rem; padding: 5px 12px;
  }
  .bar {
    background: var(--ink);
    color: var(--stock);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
  }
  .bar h1 {
    font-size: clamp(4rem, 7.4vw, 6rem);
    padding: clamp(24px, 2.6vw, 36px) var(--gutter);
    align-self: center;
  }
  .bar h1 span { color: var(--ochre); }
  .door {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(22px, 2.4vw, 32px) clamp(20px, 2.2vw, 32px);
    border-left: 2px solid var(--stock);
    text-decoration: none;
    transition: background-color 0.4s var(--ease);
  }
  .door h2 { font-size: clamp(2.25rem, 3vw, 2.75rem); }
  .door p { color: var(--stock-soft); max-width: 34ch; }
  .door .action { margin-top: auto; padding-top: 8px; color: var(--ochre); }
  .door:hover { background: var(--rust); }
  .door:hover .action { color: var(--stock); }

  @media (max-width: 960px) {
    .bar { grid-template-columns: 1fr 1fr; }
    .bar h1 { grid-column: 1 / -1; border-bottom: 2px solid var(--stock); }
    .door:first-of-type { border-left: 0; }
  }
  @media (max-width: 700px) {
    /* A shorter plate so both doors show on a phone's first screen. */
    .poster { height: auto; min-height: 0; max-height: none; grid-template-rows: 34svh auto; }
    .bar { grid-template-columns: 1fr; }
    .door { border-left: 0; border-top: 2px solid var(--stock); padding-block: 18px; gap: 6px; }
    .door h2 { font-size: 2rem; }
    .bar h1 { border-bottom: 0; }
  }
</style>
